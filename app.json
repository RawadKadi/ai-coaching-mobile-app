{
  "expo": {
    "name": "bolt-expo-nativewind",
    "slug": "bolt-expo-nativewind",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "coachingapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rawad.coachingapp",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Allow $(PRODUCT_NAME) to read your steps to sync them with your coach.",
        "NSHealthUpdateUsageDescription": "Allow $(PRODUCT_NAME) to sync your steps with your coach.",
        "NSMotionUsageDescription": "Allow $(PRODUCT_NAME) to read your steps to sync them with your coach.",
        "NSCameraUsageDescription": "Allow $(PRODUCT_NAME) to access your camera for video calls with your coach.",
        "NSMicrophoneUsageDescription": "Allow $(PRODUCT_NAME) to access your microphone for voice and video calls with your coach."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true
      }
    },
    "android": {
      "package": "com.coaching.app",
      "permissions": [
        "android.permission.health.READ_STEPS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "coachingapp"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "react-native-health-connect",
      "expo-audio",
      "expo-image",
      "expo-sharing",
      "expo-splash-screen",
      "expo-status-bar",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1cd041e9-3df6-4780-bea3-ee1afa234c3e"
      }
    },
    "runtimeVersion": "1.0.0",
    "updates": {
      "url": "https://u.expo.dev/1cd041e9-3df6-4780-bea3-ee1afa234c3e",
      "fallbackToCacheTimeout": 3000
    }
  }
}
